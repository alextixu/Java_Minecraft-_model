# Disable autocrlf on generated files, they always generate with LF
# Add any extra files or paths here to make git stop saying they
# are changed when only line endings change.
src/generated/**/.cache/cache text eol=lf
src/generated/**/*.json text eol=lf

# Keep the Unix wrapper script runnable on Linux/macOS, and the Windows one on Windows
gradlew text eol=lf
*.bat text eol=crlf

# Weapon files are compared byte for byte after a save (see WeaponJsonTest)
src/main/resources/mobarmory/**/*.json text eol=lf
